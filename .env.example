# ==============================================================================
# MIRROR CITY — Environment Variables Reference (.env.example)
# Copy this file to .env and fill in your actual values.
# 
# ⚠️ OPERATIONAL SECURITY NOTICE:
# NEVER commit a real .env file to version control. It is banned by repository
# policy and ignored in .gitignore. Any committed secrets must be rotated immediately.
# ==============================================================================

# ── Core & Server ─────────────────────────────────────────────────────────────
APP_NAME="Mirror City"
ENVIRONMENT=development                # development | staging | production
NODE_ENV=development                   # development | production

# ── Database Layer (Dual-Mode: SQLite Dev or Production PostGIS) ───────────────
DATABASE_MODE=sqlite                   # sqlite | postgis
SQLITE_PATH=./mirror_city.db           # SQLite database file path (dev mode)
POSTGIS_URL=                           # REQUIRED if DATABASE_MODE=postgis
                                       # e.g., postgresql+psycopg://mc:pass@localhost:5432/mirrorcity
DB_POOL_SIZE=10                        # Connection pool size for PostgreSQL/PostGIS
DB_MAX_OVERFLOW=20                     # Max overflow connections for pool
DATABASE_URL=                          # Backward-compat alias (auto-populated from mode if blank)

# ── Security & Authentication ─────────────────────────────────────────────────
# REQUIRED: Must be at least 32 characters long. Server fails fast at startup if missing,
# too short, or set to insecure placeholders (e.g., 'change-me', 'super-secret-key').
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440       # 24 hours
BCRYPT_ROUNDS=12
FORCE_PASSWORD_RESET_ON_FIRST_LOGIN=true

# ── Large Language Model (LLM) ────────────────────────────────────────────────
LLM_PROVIDER=auto                      # auto | gemini | openai | mock
GEMINI_API_KEY=                        # Required if LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=                        # Required if LLM_PROVIDER=openai

# ── External Traffic & Geospatial APIs ────────────────────────────────────────
ENABLE_LIVE_TRAFFIC=false              # Set true for live corridor telemetry (requires TOMTOM_API_KEY)
TOMTOM_API_KEY=                        # Required if ENABLE_LIVE_TRAFFIC=true (TomTom Traffic Flow API)
TOMTOM_POLL_INTERVAL_MIN=15            # Interval for background corridor polling

# ── Weather APIs ──────────────────────────────────────────────────────────────
OPENWEATHER_API_KEY=                   # OpenWeatherMap API key (optional, free-tier sufficient)
WEATHERAPI_API_KEY=                    # WeatherAPI key (optional alternative)

# ── Caching & Rate Limits ─────────────────────────────────────────────────────
GEOCODE_CACHE_TTL=600                  # Geocode result cache TTL in seconds
RATE_LIMIT_PER_MINUTE=60               # Maximum requests per minute per IP

# ── Climate & ENSO Intelligence ──────────────────────────────────────────────
ENSO_CACHE_TTL=21600                   # ENSO observation cache TTL in seconds (6 hours)
ENSO_API_KEY=                          # Optional external climate provider API key (if required)

# ── Data Truthfulness & Auditability ──────────────────────────────────────────
# Every telemetry observation MUST carry a source label ('live_api', 'calibrated', 'simulated').
# Set ALLOW_SIMULATED_DATA=false in production demos to reject synthetic telemetry.
ALLOW_SIMULATED_DATA=true

# ── Optional Integrations ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
