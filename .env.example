# ==============================================================================
# MIRROR CITY — Environment Variables Reference
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development                    # development | production

# ── Database ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://127.0.0.1:27017/skysense-ai   # MongoDB connection (optional)
# SQLite is used by default; no config needed for local dev

# ── Authentication ────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-key-for-mirror-city-12345     # MUST be rotated for production
JWT_EXPIRES_IN=30d

# ── AI Provider ───────────────────────────────────────────────────────────────
# Set to 'gemini' (default when key present), 'openai', or 'mock' (offline fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=                                         # Gemini API key for assistant
OPENAI_API_KEY=                                         # Optional: alternative LLM provider

# ── Weather APIs ──────────────────────────────────────────────────────────────
# OpenWeatherMap — free tier sufficient for development
OPENWEATHER_API_KEY=                                    # OpenWeatherMap API key
WEATHERAPI_API_KEY=                                     # Optional: alternative weather provider

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Push Notifications (optional) ────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# ── Performance Tuning ────────────────────────────────────────────────────────
GEOCODE_CACHE_TTL=600                  # Geocode result cache TTL in seconds (default: 600)
